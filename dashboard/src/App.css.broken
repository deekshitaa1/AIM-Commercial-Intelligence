/* =========================================================
   AIM — Commercial Intelligence Platform
   Global Dashboard Styles
   ========================================================= */

:root {
  font-family:
    Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
    "Segoe UI", sans-serif;

  color: #202638;
  background: #f5f7fb;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-width: 320px;
  min-height: 100%;
}

body {
  margin: 0;
  background:
    radial-gradient(circle at 10% 0%, rgba(104, 91, 214, 0.07), transparent 28%),
    radial-gradient(circle at 95% 5%, rgba(43, 174, 151, 0.07), transparent 25%),
    #f5f7fb;
  color: #202638;
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
  opacity: 0.65;
}

/* =========================================================
   APP SHELL
   ========================================================= */

.app-shell {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 235px;
  padding: 22px 15px;
  background: rgba(255, 255, 255, 0.94);
  border-right: 1px solid #e7eaf1;
  backdrop-filter: blur(16px);
  z-index: 20;
}

.main-content {
  width: calc(100% - 235px);
  margin-left: 235px;
  padding: 24px 28px 40px;
}

/* =========================================================
   BRAND
   ========================================================= */

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 3px 8px 26px;
}

.brand-mark {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  color: #ffffff;
  background: linear-gradient(135deg, #6255d9, #8277eb);
  box-shadow: 0 8px 20px rgba(98, 85, 217, 0.2);
}

.brand-text strong {
  display: block;
  color: #242a3b;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.brand-text span {
  display: block;
  margin-top: 2px;
  color: #9aa1b1;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: 0.1em;
}

/* =========================================================
   SIDEBAR NAVIGATION
   ========================================================= */

.nav-section {
  margin-bottom: 22px;
}

.nav-title {
  padding: 0 9px 8px;
  color: #a3a9b6;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.nav-item {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 10px;
  margin-bottom: 3px;
  border: 0;
  border-radius: 8px;
  color: #687185;
  background: transparent;
  font-size: 11px;
  font-weight: 600;
  text-align: left;
  transition:
    background 0.18s ease,
    color 0.18s ease,
    transform 0.18s ease;
}

.nav-item:hover {
  color: #3d4660;
  background: #f4f5fa;
}

.nav-item.active {
  color: #5d51ca;
  background: #f0effd;
}

.nav-item svg {
  flex-shrink: 0;
}

/* =========================================================
   TOP BAR
   ========================================================= */

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 24px;
}

.workspace {
  display: flex;
  align-items: center;
  gap: 8px;
}

.workspace-label {
  color: #a0a6b3;
  font-size: 9px;
  font-weight: 700;
}

.workspace-value {
  color: #424b61;
  font-size: 10px;
  font-weight: 700;
}

.api-status {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 7px 10px;
  border: 1px solid #e5e9ef;
  border-radius: 999px;
  background: #ffffff;
  color: #687185;
  font-size: 9px;
  font-weight: 700;
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #30b67a;
  box-shadow: 0 0 0 3px rgba(48, 182, 122, 0.1);
}

/* =========================================================
   PAGE HEADER
   ========================================================= */

.page-header {
  margin-bottom: 22px;
}

.eyebrow {
  margin: 0 0 6px;
  color: #6b5dd4;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.12em;
}

.page-header h1 {
  margin: 0;
  color: #202638;
  font-size: 28px;
  line-height: 1.15;
  letter-spacing: -0.035em;
}

.page-header p {
  max-width: 720px;
  margin: 8px 0 0;
  color: #7b8496;
  font-size: 11px;
  line-height: 1.6;
}

/* =========================================================
   KPI CARDS
   ========================================================= */

.kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 13px;
  margin-bottom: 18px;
}

.kpi-card {
  position: relative;
  min-height: 118px;
  padding: 17px;
  overflow: hidden;
  border: 1px solid #e7eaf1;
  border-radius: 13px;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 7px 24px rgba(34, 42, 63, 0.035);
}

.kpi-card::after {
  content: "";
  position: absolute;
  right: -20px;
  bottom: -25px;
  width: 75px;
  height: 75px;
  border-radius: 50%;
  background: #f5f3ff;
}

.kpi-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.kpi-label {
  color: #929aaa;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.07em;
  text-transform: uppercase;
}

.kpi-icon {
  width: 27px;
  height: 27px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  color: #6556d7;
  background: #f2f0ff;
}

.kpi-value {
  position: relative;
  z-index: 2;
  margin-top: 17px;
  color: #242a3b;
  font-size: 23px;
  font-weight: 800;
  letter-spacing: -0.035em;
}

.kpi-meta {
  margin-top: 5px;
  color: #98a0ae;
  font-size: 9px;
}

/* =========================================================
   CONTENT GRID
   ========================================================= */

.content-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) minmax(290px, 0.85fr);
  gap: 15px;
  margin-bottom: 15px;
}

.panel {
  min-width: 0;
  padding: 17px;
  border: 1px solid #e7eaf1;
  border-radius: 13px;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 7px 24px rgba(34, 42, 63, 0.035);
}

.panel-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 17px;
}

.panel-header h2 {
  margin: 0;
  color: #2b3244;
  font-size: 13px;
  font-weight: 800;
}

.panel-header p {
  margin: 4px 0 0;
  color: #9aa1af;
  font-size: 9px;
}

/* =========================================================
   CHARTS
   ========================================================= */

.chart-container {
  width: 100%;
  height: 255px;
}

.chart-container.large {
  height: 285px;
}

.recharts-text {
  font-size: 9px;
}

.recharts-cartesian-axis-tick-value {
  fill: #8d95a5;
}

.recharts-default-tooltip {
  border: 1px solid #e5e8ef !important;
  border-radius: 9px !important;
  box-shadow: 0 10px 30px rgba(32, 38, 56, 0.08) !important;
}

/* =========================================================
   SEGMENTS
   ========================================================= */

.segment-list {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.segment-row {
  padding: 11px;
  border: 1px solid #edf0f4;
  border-radius: 9px;
  background: #fbfcfe;
}

.segment-row-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.segment-name {
  color: #3c4558;
  font-size: 10px;
  font-weight: 800;
}

.segment-rate {
  color: #6556d7;
  font-size: 10px;
  font-weight: 800;
}

.segment-bar {
  height: 5px;
  margin-top: 8px;
  overflow: hidden;
  border-radius: 999px;
  background: #eceef4;
}

.segment-bar-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #786be2, #a29aec);
}

.segment-meta {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin-top: 7px;
  color: #969eac;
  font-size: 8px;
}

/* =========================================================
   TABLES
   ========================================================= */

.table-wrap {
  width: 100%;
  overflow-x: auto;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
}

.data-table th {
  padding: 9px 10px;
  border-bottom: 1px solid #eceff4;
  color: #969eac;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-align: left;
  text-transform: uppercase;
}

.data-table td {
  padding: 10px;
  border-bottom: 1px solid #f0f2f6;
  color: #596477;
  font-size: 9px;
}

.data-table tbody tr:hover {
  background: #fafbfe;
}

.data-table td strong {
  color: #30384b;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4px 7px;
  border-radius: 999px;
  font-size: 7px;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.badge.high {
  color: #16845b;
  background: #eaf9f1;
}

.badge.medium {
  color: #8a6915;
  background: #fff7df;
}

.badge.low {
  color: #687185;
  background: #f0f2f5;
}

.badge.risk {
  color: #ad4d56;
  background: #fff0f1;
}

/* =========================================================
   RECOMMENDATIONS
   ========================================================= */

.recommendation-list {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.recommendation-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 11px;
  border: 1px solid #edf0f4;
  border-radius: 9px;
  background: #fbfcff;
}

.recommendation-icon {
  width: 28px;
  height: 28px;
  min-width: 28px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  color: #6556d7;
  background: #f1efff;
}

.recommendation-content {
  min-width: 0;
}

.recommendation-content strong {
  display: block;
  color: #3b4355;
  font-size: 9px;
}

.recommendation-content p {
  margin: 4px 0 0;
  color: #8991a0;
  font-size: 8px;
  line-height: 1.5;
}

/* =========================================================
   ASK AIM
   ========================================================= */

.ask-panel {
  margin-top: 15px;
  padding: 19px;
  border: 1px solid #dfdcf7;
  border-radius: 14px;
  background:
    radial-gradient(circle at 100% 0%, rgba(125, 111, 225, 0.09), transparent 28%),
    linear-gradient(135deg, #fbfaff, #f7fbff);
  box-shadow: 0 10px 30px rgba(72, 62, 142, 0.045);
}

.ask-copy {
  display: flex;
  align-items: flex-start;
  gap: 11px;
}

.ask-icon {
  width: 36px;
  height: 36px;
  min-width: 36px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  color: #6658d5;
  background: #eeecff;
}

.ask-copy h2 {
  margin: 2px 0 0;
  color: #282f42;
  font-size: 17px;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.ask-copy p:not(.eyebrow) {
  max-width: 650px;
  margin: 5px 0 0;
  color: #7e8798;
  font-size: 9px;
  line-height: 1.55;
}

.ask-box {
  display: flex;
  gap: 9px;
  margin-top: 16px;
}

.ask-box input {
  flex: 1;
  min-width: 0;
  height: 40px;
  padding: 0 13px;
  border: 1px solid #dfe3eb;
  border-radius: 9px;
  outline: none;
  color: #394155;
  background: #ffffff;
  font-size: 10px;
  transition:
    border-color 0.18s ease,
    box-shadow 0.18s ease;
}

.ask-box input::placeholder {
  color: #a5abb7;
}

.ask-box input:focus {
  border-color: #8e84df;
  box-shadow: 0 0 0 3px rgba(102, 88, 213, 0.08);
}

.ask-box button {
  height: 40px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 0 16px;
  border: 0;
  border-radius: 9px;
  color: #ffffff;
  background: linear-gradient(135deg, #6255d9, #7769e3);
  box-shadow: 0 7px 16px rgba(98, 85, 217, 0.17);
  font-size: 9px;
  font-weight: 800;
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease;
}

.ask-box button:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 9px 20px rgba(98, 85, 217, 0.22);
}

/* =========================================================
   ASK AIM RESULT
   ========================================================= */

.aim-result {
  margin-top: 14px;
  padding: 16px;
  border: 1px solid #e4e7ef;
  border-radius: 12px;
  background: #ffffff;
}

.aim-result-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 13px;
}

.aim-result-header h3 {
  margin: 3px 0 0;
  color: #293244;
  font-size: 13px;
}

.result-label {
  display: block;
  color: #5368d3;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.aim-mode {
  padding: 5px 8px;
  border-radius: 999px;
  color: #16845b;
  background: #eaf9f1;
  font-size: 8px;
  font-weight: 800;
  white-space: nowrap;
}

.aim-answer {
  padding: 13px;
  border: 1px solid #edf0f5;
  border-radius: 9px;
  background: #f8f9fc;
}

.aim-answer p {
  margin: 0;
  color: #596477;
  font-size: 10px;
  line-height: 1.65;
}

.aim-evidence {
  margin-top: 14px;
}

.evidence-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
  margin-top: 8px;
}

.evidence-card {
  min-width: 0;
  padding: 10px;
  border: 1px solid #edf0f4;
  border-radius: 8px;
  background: #fbfcff;
}

.evidence-card span {
  display: block;
  margin-bottom: 5px;
  color: #929aaa;
  font-size: 8px;
  font-weight: 700;
}

.evidence-card strong {
  display: block;
  overflow: hidden;
  color: #293244;
  font-size: 13px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.aim-recommendation {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  margin-top: 13px;
  padding: 12px;
  border: 1px solid #e5e1fa;
  border-radius: 9px;
  background: linear-gradient(120deg, #f5f2ff, #f2f8ff);
}

.aim-recommendation .recommendation-icon {
  width: 28px;
  height: 28px;
  min-width: 28px;
  display: grid;
  place-items: center;
  color: #6556d7;
  background: #ffffff;
  border-radius: 7px;
}

.aim-recommendation > div:last-child {
  flex: 1;
  min-width: 0;
}

.aim-recommendation p {
  margin: 4px 0 0;
  color: #596477;
  font-size: 10px;
  line-height: 1.55;
}

/* =========================================================
   LOADING / EMPTY / ERROR
   ========================================================= */

.loading {
  display: grid;
  min-height: 300px;
  place-items: center;
  color: #8c94a3;
  font-size: 11px;
}

.error-state {
  padding: 20px;
  border: 1px solid #f1d8db;
  border-radius: 11px;
  color: #a84e57;
  background: #fff6f7;
  font-size: 10px;
}

.empty-state {
  padding: 25px;
  color: #9aa1af;
  text-align: center;
  font-size: 10px;
}

/* =========================================================
   FOOTER
   ========================================================= */

.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-top: 20px;
  padding: 12px 3px;
  color: #a0a7b4;
  font-size: 8px;
}

.footer strong {
  color: #6f7788;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1150px) {
  .sidebar {
    width: 210px;
  }

  .main-content {
    width: calc(100% - 210px);
    margin-left: 210px;
    padding-left: 20px;
    padding-right: 20px;
  }

  .kpi-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 900px) {
  .sidebar {
    position: static;
    width: 190px;
  }

  .main-content {
    width: calc(100% - 190px);
    margin-left: 0;
  }

  .content-grid {
    grid-template-columns: 1fr;
  }

  .evidence-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 700px) {
  .app-shell {
    display: block;
  }

  .sidebar {
    position: static;
    width: 100%;
    min-height: auto;
    padding: 12px;
    border-right: 0;
    border-bottom: 1px solid #e7eaf1;
  }

  .brand {
    padding-bottom: 12px;
  }

  .nav-section {
    display: none;
  }

  .main-content {
    width: 100%;
    margin-left: 0;
    padding: 18px 14px 30px;
  }

  .topbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .page-header h1 {
    font-size: 24px;
  }

  .kpi-grid {
    grid-template-columns: 1fr;
  }

  .ask-box {
    flex-direction: column;
  }

  .ask-box button {
    width: 100%;
  }

  .evidence-grid {
    grid-template-columns: 1fr;
  }

  .aim-result-header {
    flex-direction: column;
  }

  .footer {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 420px) {
  .main-content {
    padding-left: 10px;
    padding-right: 10px;
  }

  .panel,
  .ask-panel {
    padding: 13px;
  }

  .kpi-card {
    padding: 14px;
  }

  .page-header h1 {
    font-size: 21px;
  }
}